  <pyqgis_plugin name="K-FRM" version="1.8.10">
    <description>Korean-Flood Risk assessment Model</description>
    <about>K-FRM is a service that analyzes building, vehicle, agricultural, life(population), and infrastructure losses based on inundation map according to flooding scenarios.</about>
    <version>1.8.10</version>
    <qgis_minimum_version>3.0</qgis_minimum_version>
    <qgis_maximum_version>3.99</qgis_maximum_version>
    <homepage>https://github.com/floodmodel/K-FRM/wiki</homepage>
    <file_name>kfrm_tool.zip</file_name>
    <author_name>KICT, Hermesys</author_name>
    <download_url>https://github.com/floodmodel/K-FRM/releases/download/v1.8.10/kfrm_tool.v1.8.10.zip</download_url>
    <experimental>False</experimental>
    <deprecated>False</deprecated>
    <tags>K-FRM, flood damage, flood loss, inundation, inventory</tags>
  </pyqgis_plugin>

